+void FunctionPercentScale::SelectionChanged(const FunscriptSelectionChangedEvent* ev) noexcept
+{
+    OFS_PROFILE(__FUNCTION__);
+    RefreshBaselineIfNeeded();
+}
+
+void FunctionPercentScale::RefreshBaselineIfNeeded() noexcept
+{
+    auto& liveSelection = ctx().Selection();
+    if (liveSelection.empty()) return;
+
+    // Same set of actions (by time, not position) as what's already stored -> this is our own
+    // edit echoing back, or a repeat interaction on the same selection. Leave the baseline alone.
+    bool isSameSelection = !originalSelection.empty()
+        && liveSelection.size() == originalSelection.size()
+        && liveSelection.front().atS == originalSelection.front().atS
+        && liveSelection.back().atS == originalSelection.back().atS;
+    if (isSameSelection) return;
+
+    percent = 100.f;
+    originalSelection = liveSelection;
+}
+
+void FunctionPercentScale::DrawUI() noexcept
+{
+    auto app = OpenFunscripter::ptr;
+    auto& undoSystem = app->ActiveFunscript()->undoSystem;
+    if (app->ActiveFunscript()->SelectionSize() > 4 || (undoSystem->MatchUndoTop(StateType::PERCENT_SCALE))) {
+        RefreshBaselineIfNeeded();
+        if (ImGui::SliderFloat(TR(PERCENT_SCALE_AMOUNT), &percent, 0.f, 200.f, "%.0f%%", ImGuiSliderFlags_AlwaysClamp)) {
+            percent = Util::Clamp<float>(percent, 0.f, 200.f);
+            // One undo entry per interaction (drag or discrete click), taken before the first
+            // change so Ctrl+Z reverts the whole gesture in one step. No need to Undo()+resnapshot
+            // on every intermediate frame the way RangeExtender/Simplify do: PercentScaleSelection
+            // always recomputes from the immutable `originalSelection` snapshot rather than
+            // whatever the timeline currently shows, so repeated/separate interactions (drags,
+            // discrete clicks at different points) can no longer compound on top of each other -
+            // only the final `percent` value when you stop matters.
+            if (ImGui::IsItemActivated()) {
+                app->undoSystem->Snapshot(StateType::PERCENT_SCALE, app->ActiveFunscript());
+            }
+            ctx().PercentScaleSelection(originalSelection, percent);
+        }
+    }
+    else {
+        ImGui::Text(TR(PERCENT_SCALE_TXT));
+    }
+}
+
+// normalize
+void FunctionNormalizeSelection::DrawUI() noexcept
+{
+    auto app = OpenFunscripter::ptr;
+    if (app->ActiveFunscript()->SelectionSize() > 4) {
+        if (ImGui::Button(TR(NORMALIZE_BUTTON), ImVec2(-1.f, 0.f))) {
+            auto selection = ctx().Selection();
+            float lo = 100.f, hi = 0.f;
+            for (auto& a : selection) {
+                lo = std::min<float>(lo, a.pos);
+                hi = std::max<float>(hi, a.pos);
+            }
+            // a selection that's already flat has nothing to rescale - dividing by (hi-lo) would
+            // blow up, and there'd be no meaningful "0-100%" to map it to anyway
+            if (hi - lo > 0.5f) {
+                app->undoSystem->Snapshot(StateType::NORMALIZE_SELECTION, app->ActiveFunscript());
+                ctx().RemoveSelectedActions();
+                FunscriptArray newActions;
+                newActions.reserve(selection.size());
+                for (auto act : selection) {
+                    float norm = (act.pos - lo) / (hi - lo) * 100.f;
+                    act.pos = (int16_t)Util::Clamp<float>(norm, 0.f, 100.f);
+                    newActions.emplace_back_unsorted(act);
+                }
+                ctx().AddMultipleActions(newActions);
+            }
+        }
+    }
+    else {
+        ImGui::Text(TR(NORMALIZE_TXT));
+    }
+}
