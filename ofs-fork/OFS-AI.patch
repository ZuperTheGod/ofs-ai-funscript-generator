+                app->undoSystem->Snapshot(StateType::DOWNSAMPLE_SELECTION, app->ActiveFunscript());
+            }
+            createUndoState = false;
+            auto selection = ctx().Selection();
+            ctx().RemoveSelectedActions();
+            auto downsampled = DownsampleArray(selection, factor);
+            ctx().AddMultipleActions(downsampled);
+        }
+    }
