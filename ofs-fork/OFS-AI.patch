+
+// Moving average over `window` neighbours on each side, clamped at the selection's edges
+// (an edge point averages over fewer neighbours rather than wrapping or losing data). Only
+// smooths pos - timestamps are left untouched.
+static FunscriptArray SmoothArray(const FunscriptArray& points, int32_t window) noexcept
+{
+    FunscriptArray result;
+    result.reserve(points.size());
+    int32_t n = (int32_t)points.size();
+    for (int32_t i = 0; i < n; ++i) {
+        int32_t lo = std::max(0, i - window);
+        int32_t hi = std::min(n - 1, i + window);
+        float sum = 0.f;
+        int32_t count = 0;
+        for (int32_t j = lo; j <= hi; ++j) { sum += points[j].pos; ++count; }
+        FunscriptAction act = points[i];
+        act.pos = (int16_t)Util::Clamp<float>(sum / (float)count, 0.f, 100.f);
+        result.emplace_back_unsorted(act);
+    }
+    return result;
+}
+
+void FunctionSmoothSelection::DrawUI() noexcept
+{
+    auto app = OpenFunscripter::ptr;
+    auto& undoSystem = app->ActiveFunscript()->undoSystem;
+    if (app->ActiveFunscript()->SelectionSize() > 4 || (undoSystem->MatchUndoTop(StateType::SMOOTH_SELECTION))) {
+        if (ImGui::SliderInt(TR(SMOOTH_WINDOW), &window, 0, 10)) {
+            window = Util::Clamp<int32_t>(window, 0, 10);
+            if (createUndoState ||
+                !undoSystem->MatchUndoTop(StateType::SMOOTH_SELECTION)) {
+                app->undoSystem->Snapshot(StateType::SMOOTH_SELECTION, app->ActiveFunscript());
+            }
+            else {
+                app->undoSystem->Undo();
+                app->undoSystem->Snapshot(StateType::SMOOTH_SELECTION, app->ActiveFunscript());
+            }
+            createUndoState = false;
+            auto selection = ctx().Selection();
+            ctx().RemoveSelectedActions();
+            auto smoothed = SmoothArray(selection, window);
+            ctx().AddMultipleActions(smoothed);
+        }
+    }
+    else {
+        ImGui::Text(TR(SMOOTH_TXT));
+    }
+}
