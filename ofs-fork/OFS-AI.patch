+void FunctionSmoothSelection::SelectionChanged(const FunscriptSelectionChangedEvent* ev) noexcept
+{
+    OFS_PROFILE(__FUNCTION__);
+    auto app = OpenFunscripter::ptr;
+    if (!app->ActiveFunscript()->Selection().empty()) {
+        window = 0;
