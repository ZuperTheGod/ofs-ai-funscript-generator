+void ScriptTimeline::CreateFunscriptFromCVTrack() noexcept
+{
+	if (!activeScriptForCV || pendingCVPoints.size() < 3) {
+		pendingCVPoints.clear();
+		return;
+	}
+
+	auto& trackState = CVTrackState::State(cvTrackStateHandle);
+
+	std::vector<FunscriptAction> actions;
+	SimplifyCurveToActions(pendingCVPoints, trackState.Settings, actions);
+
+	if (actions.empty()) {
+		LOG_WARN("CV track produced too few significant points to script - try lowering Min amplitude.");
+		pendingCVPoints.clear();
+		return;
+	}
+
+	float fromTime = pendingCVPoints.front().timeMs / 1000.f;
+	float toTime = pendingCVPoints.back().timeMs / 1000.f;
+	EV::Enqueue<CVTrackShouldApplyEvent>(activeScriptForCV, fromTime, toTime, std::move(actions));
+
+	pendingCVPoints.clear();
+}
