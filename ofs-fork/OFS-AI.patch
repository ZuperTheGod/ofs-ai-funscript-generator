+
+void FunctionFillGapsSelection::SelectionChanged(const FunscriptSelectionChangedEvent* ev) noexcept
+{
+    OFS_PROFILE(__FUNCTION__);
+    auto app = OpenFunscripter::ptr;
+    if (!app->ActiveFunscript()->Selection().empty()) {
+        maxGapMs = 500;
+        createUndoState = true;
+    }
+}
+
+// Wherever two adjacent points are further apart than maxGapMs, inserts evenly spaced, linearly
+// interpolated points between them so no sub-gap exceeds the threshold. Existing points are never
+// moved or removed - this only ever adds.
+static FunscriptArray FillGapsArray(const FunscriptArray& points, int32_t maxGapMs) noexcept
+{
+    FunscriptArray result;
+    result.reserve(points.size());
+    int32_t n = (int32_t)points.size();
+    float maxGapS = maxGapMs / 1000.f;
+    for (int32_t i = 0; i < n; ++i) {
+        result.emplace_back_unsorted(points[i]);
+        if (i == n - 1) continue;
+
+        float gap = points[i + 1].atS - points[i].atS;
+        int32_t subdivisions = (int32_t)std::ceil(gap / maxGapS);
+        for (int32_t s = 1; s < subdivisions; ++s) {
+            float t = (float)s / (float)subdivisions;
+            float at = points[i].atS + gap * t;
+            float pos = points[i].pos + (points[i + 1].pos - points[i].pos) * t;
+            result.emplace_back_unsorted(FunscriptAction(at, (int32_t)Util::Clamp<float>(pos, 0.f, 100.f)));
+        }
+    }
+    return result;
+}
+
+void FunctionFillGapsSelection::DrawUI() noexcept
+{
+    auto app = OpenFunscripter::ptr;
+    auto& undoSystem = app->ActiveFunscript()->undoSystem;
+    if (app->ActiveFunscript()->SelectionSize() > 4 || (undoSystem->MatchUndoTop(StateType::FILL_GAPS_SELECTION))) {
+        if (ImGui::SliderInt(TR(FILL_GAPS_AMOUNT), &maxGapMs, 50, 2000, "%d", ImGuiSliderFlags_AlwaysClamp)) {
+            maxGapMs = Util::Clamp<int32_t>(maxGapMs, 50, 2000);
+            if (createUndoState ||
+                !undoSystem->MatchUndoTop(StateType::FILL_GAPS_SELECTION)) {
+                app->undoSystem->Snapshot(StateType::FILL_GAPS_SELECTION, app->ActiveFunscript());
+            }
+            else {
+                app->undoSystem->Undo();
+                app->undoSystem->Snapshot(StateType::FILL_GAPS_SELECTION, app->ActiveFunscript());
+            }
+            createUndoState = false;
+            auto selection = ctx().Selection();
+            ctx().RemoveSelectedActions();
+            auto filled = FillGapsArray(selection, maxGapMs);
+            ctx().AddMultipleActions(filled);
+        }
+    }
+    else {
+        ImGui::Text(TR(FILL_GAPS_TXT));
+    }
+}
