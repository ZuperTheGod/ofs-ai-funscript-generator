+FunctionTempoFilterSelection::~FunctionTempoFilterSelection() noexcept
+{
+    eventUnsub();
+}
+
+void FunctionTempoFilterSelection::SelectionChanged(const FunscriptSelectionChangedEvent* ev) noexcept
+{
+    OFS_PROFILE(__FUNCTION__);
+    auto app = OpenFunscripter::ptr;
+    if (!app->ActiveFunscript()->Selection().empty()) {
+        maxSpeed = 400.f;
+        createUndoState = true;
+    }
+}
+
+// Greedily drops points that would require exceeding maxSpeed (%/s) to reach from the last kept
+// point - i.e. caps how fast the stroke is allowed to move, merging out whatever was too fast to
+// physically follow. First and last point are always kept so the selection's endpoints/time range
+// don't shrink (the final segment may still exceed maxSpeed as a result).
+static FunscriptArray TempoFilterArray(const FunscriptArray& points, float maxSpeed) noexcept
+{
+    FunscriptArray result;
+    int32_t n = (int32_t)points.size();
+    if (n == 0) return result;
+    result.reserve(n);
+
+    result.emplace_back_unsorted(points[0]);
+    int32_t lastKept = 0;
+    for (int32_t i = 1; i < n - 1; ++i) {
+        float dt = points[i].atS - points[lastKept].atS;
+        float dPos = std::abs((float)points[i].pos - (float)points[lastKept].pos);
+        float requiredDt = dPos / maxSpeed;
+        if (dt >= requiredDt) {
+            result.emplace_back_unsorted(points[i]);
+            lastKept = i;
+        }
+    }
+    if (n > 1) {
+        result.emplace_back_unsorted(points[n - 1]);
+    }
+    return result;
+}
+
+void FunctionTempoFilterSelection::DrawUI() noexcept
+{
+    auto app = OpenFunscripter::ptr;
+    auto& undoSystem = app->ActiveFunscript()->undoSystem;
+    if (app->ActiveFunscript()->SelectionSize() > 4 || (undoSystem->MatchUndoTop(StateType::TEMPO_FILTER_SELECTION))) {
+        if (ImGui::SliderFloat(TR(TEMPO_FILTER_AMOUNT), &maxSpeed, 20.f, 2000.f, "%.0f", ImGuiSliderFlags_AlwaysClamp)) {
+            maxSpeed = Util::Clamp<float>(maxSpeed, 20.f, 2000.f);
+            if (createUndoState ||
+                !undoSystem->MatchUndoTop(StateType::TEMPO_FILTER_SELECTION)) {
+                app->undoSystem->Snapshot(StateType::TEMPO_FILTER_SELECTION, app->ActiveFunscript());
+            }
+            else {
+                app->undoSystem->Undo();
+                app->undoSystem->Snapshot(StateType::TEMPO_FILTER_SELECTION, app->ActiveFunscript());
+            }
+            createUndoState = false;
+            auto selection = ctx().Selection();
+            ctx().RemoveSelectedActions();
+            auto filtered = TempoFilterArray(selection, maxSpeed);
+            ctx().AddMultipleActions(filtered);
+        }
+    }
+    else {
+        ImGui::Text(TR(TEMPO_FILTER_TXT));
+    }
+}
+
+// edge filter
+FunctionEdgeFilterSelection::FunctionEdgeFilterSelection() noexcept
+{
+    eventUnsub = EV::MakeUnsubscibeFn(FunscriptSelectionChangedEvent::EventType,
+        EV::Queue().appendListener(FunscriptSelectionChangedEvent::EventType,
+           FunscriptSelectionChangedEvent::HandleEvent(EVENT_SYSTEM_BIND(this, &FunctionEdgeFilterSelection::SelectionChanged))));
+}
+
+FunctionEdgeFilterSelection::~FunctionEdgeFilterSelection() noexcept
+{
+    eventUnsub();
+}
+
+void FunctionEdgeFilterSelection::SelectionChanged(const FunscriptSelectionChangedEvent* ev) noexcept
+{
+    OFS_PROFILE(__FUNCTION__);
+    auto app = OpenFunscripter::ptr;
+    if (!app->ActiveFunscript()->Selection().empty()) {
+        threshold = 10;
+        createUndoState = true;
+    }
+}
+
+// Snaps any point within `threshold`% of 0 or 100 to that true edge, so near-misses register as
+// full strokes on hardware. Points outside the threshold band are left untouched.
+static FunscriptArray EdgeFilterArray(const FunscriptArray& points, int32_t threshold) noexcept
+{
+    FunscriptArray result;
+    result.reserve(points.size());
+    for (auto act : points) {
+        if (act.pos <= threshold) {
+            act.pos = 0;
+        }
+        else if (act.pos >= 100 - threshold) {
+            act.pos = 100;
+        }
+        result.emplace_back_unsorted(act);
+    }
+    return result;
+}
+
+void FunctionEdgeFilterSelection::DrawUI() noexcept
+{
+    auto app = OpenFunscripter::ptr;
+    auto& undoSystem = app->ActiveFunscript()->undoSystem;
+    if (app->ActiveFunscript()->SelectionSize() > 4 || (undoSystem->MatchUndoTop(StateType::EDGE_FILTER_SELECTION))) {
+        if (ImGui::SliderInt(TR(EDGE_FILTER_AMOUNT), &threshold, 0, 30, "%d", ImGuiSliderFlags_AlwaysClamp)) {
+            threshold = Util::Clamp<int32_t>(threshold, 0, 30);
+            if (createUndoState ||
+                !undoSystem->MatchUndoTop(StateType::EDGE_FILTER_SELECTION)) {
+                app->undoSystem->Snapshot(StateType::EDGE_FILTER_SELECTION, app->ActiveFunscript());
+            }
+            else {
+                app->undoSystem->Undo();
+                app->undoSystem->Snapshot(StateType::EDGE_FILTER_SELECTION, app->ActiveFunscript());
+            }
+            createUndoState = false;
+            auto selection = ctx().Selection();
+            ctx().RemoveSelectedActions();
+            auto filtered = EdgeFilterArray(selection, threshold);
+            ctx().AddMultipleActions(filtered);
+        }
+    }
+    else {
+        ImGui::Text(TR(EDGE_FILTER_TXT));
+    }
 }
