+void ScriptTimeline::AudioClassificationFinished(const AudioClassificationFinishedEvent* ev) noexcept
+{
+	classifying = false;
+	if (!ev->success) {
+		LOG_ERROR("Audio classification failed.");
+		return;
+	}
+	auto& classState = AudioClassState::State(audioClassStateHandle);
+	classState.Filename = videoPath;
+	classState.Segments = std::move(pendingSegments);
+	pendingSegments.clear();
+	ShowClassificationOverlay = true;
+
+	if (lastRunUsedSeparation && VocalsWave.data.SampleCount() > 0 && InstrumentalWave.data.SampleCount() > 0) {
+		ShowSeparatedLanes = true;
+	}
+	else {
+		ShowSeparatedLanes = false;
+	}
+	LOG_INFO("Audio classification complete.");
+}
+
+void ScriptTimeline::roiSelected(const ROISelectedEvent* ev) noexcept
+{
+	auto& state = CVTrackState::State(cvTrackStateHandle);
+	state.Filename = videoPath;
+	state.HasROI = true;
+	state.Settings.RoiX = ev->x;
+	state.Settings.RoiY = ev->y;
+	state.Settings.RoiW = ev->w;
+	state.Settings.RoiH = ev->h;
+	LOG_INFO("CV tracker ROI selected.");
+}
+
+void ScriptTimeline::CVTrackingFinished(const CVTrackingFinishedEvent* ev) noexcept
+{
+	cvTracking = false;
+	if (!ev->success) {
+		LOG_ERROR("Computer vision tracking failed.");
+		pendingCVPoints.clear();
+		return;
+	}
+	CreateFunscriptFromCVTrack();
+	LOG_INFO("Computer vision tracking complete.");
+}
