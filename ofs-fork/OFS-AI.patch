+void OFS_VideoplayerWindow::roiSelectionRequested(const ROISelectionRequestEvent* ev) noexcept
+{
+	roiSelectActive = true;
+	roiDragging = false;
+	dragStarted = false; // in case a pan-drag was mid-flight
+	player->SetPaused(true); // the ROI is only meaningful for the frame it was drawn on
+}
+
+// Called every frame while roiSelectActive, from inside the same `if (*drawVideo)` block that
+// just computed videoHovered/videoDrawSize/state.videoPos for this frame's draw2dVideo() call -
+// reuses that same screen-to-local-video-space mapping mouseScroll() uses for its zoom point.
+void OFS_VideoplayerWindow::handleRoiSelection(ImDrawList* draw_list) noexcept
+{
+	auto& state = VideoPlayerWindowState::State(stateHandle);
+	ImVec2 mousePosInVid = ImGui::GetMousePos() - viewportPos - windowPos - state.videoPos;
+
+	if (!roiDragging) {
+		if (videoHovered && ImGui::IsMouseClicked(ImGuiMouseButton_Left)) {
+			roiDragging = true;
+			roiDragStartLocal = mousePosInVid;
+		}
+		return;
+	}
+
+	ImVec2 a = roiDragStartLocal;
+	ImVec2 b = mousePosInVid;
+	ImVec2 screenA = a + viewportPos + windowPos + state.videoPos;
+	ImVec2 screenB = b + viewportPos + windowPos + state.videoPos;
+	draw_list->AddRectFilled(screenA, screenB, IM_COL32(255, 220, 0, 60));
+	draw_list->AddRect(screenA, screenB, IM_COL32(255, 220, 0, 255), 0.f, 0, 2.f);
+
+	if (ImGui::IsMouseReleased(ImGuiMouseButton_Left)) {
+		roiDragging = false;
+		roiSelectActive = false;
+
+		ImVec2 lo(Util::Min(a.x, b.x), Util::Min(a.y, b.y));
+		ImVec2 hi(Util::Max(a.x, b.x), Util::Max(a.y, b.y));
+		// clamp to the visible video rect before normalizing - a drag can end outside it
+		lo.x = Util::Clamp(lo.x, 0.f, videoDrawSize.x); lo.y = Util::Clamp(lo.y, 0.f, videoDrawSize.y);
+		hi.x = Util::Clamp(hi.x, 0.f, videoDrawSize.x); hi.y = Util::Clamp(hi.y, 0.f, videoDrawSize.y);
+
+		if (videoDrawSize.x > 0.f && videoDrawSize.y > 0.f && (hi.x - lo.x) > 2.f && (hi.y - lo.y) > 2.f) {
+			EV::Enqueue<ROISelectedEvent>(
+				lo.x / videoDrawSize.x, lo.y / videoDrawSize.y,
+				(hi.x - lo.x) / videoDrawSize.x, (hi.y - lo.y) / videoDrawSize.y);
+		}
+		// else: degenerate drag (a click, not a drag) - silently ignored, selection stays unarmed
+	}
+}
