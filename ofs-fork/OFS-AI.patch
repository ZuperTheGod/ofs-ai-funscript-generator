+void ScriptTimeline::SimplifyCurveToActions(
+	const std::vector<CVTrackPoint>& points,
+	const CVTrackerSettings& settings,
+	std::vector<FunscriptAction>& outActions) noexcept
+{
+	outActions.clear();
+	if (points.size() < 3) return;
+
+	// Pass 1: every local extremum (turning point) in the raw per-frame curve - unambiguous,
+	// each point is only compared against its immediate neighbours.
+	std::vector<size_t> turningIdx;
+	turningIdx.push_back(0);
+	for (size_t i = 1; i + 1 < points.size(); ++i) {
+		float prev = points[i - 1].value;
+		float cur = points[i].value;
+		float next = points[i + 1].value;
+		if ((cur >= prev && cur > next) || (cur <= prev && cur < next)) {
+			turningIdx.push_back(i);
+		}
+	}
+	turningIdx.push_back(points.size() - 1);
+
+	// Pass 2: greedily keep a turning point only once its swing and time gap from the last KEPT
+	// point both clear the configured minimums - this is what turns "every wiggle" into "one
+	// action per real stroke". Small in-between turning points get dropped, not the extremes.
+	size_t lastKeptIdx = turningIdx.front();
+	outActions.emplace_back(points[lastKeptIdx].timeMs / 1000.f, (int32_t)Util::Clamp(points[lastKeptIdx].value, 0.f, 100.f));
+
+	for (size_t k = 1; k < turningIdx.size(); ++k) {
+		size_t idx = turningIdx[k];
+		float dv = fabsf(points[idx].value - points[lastKeptIdx].value);
+		float dt = points[idx].timeMs - points[lastKeptIdx].timeMs;
+		if (dv >= settings.MinAmplitude && dt >= settings.MinPointGapMs) {
+			outActions.emplace_back(points[idx].timeMs / 1000.f, (int32_t)Util::Clamp(points[idx].value, 0.f, 100.f));
+			lastKeptIdx = idx;
+		}
+	}
+	// always keep the true final sample so the script covers the whole analyzed range
+	if (lastKeptIdx != turningIdx.back()) {
+		outActions.emplace_back(points.back().timeMs / 1000.f, (int32_t)Util::Clamp(points.back().value, 0.f, 100.f));
+	}
+
+	if (outActions.size() < 2) outActions.clear();
+}
