+void FunctionDownsampleSelection::SelectionChanged(const FunscriptSelectionChangedEvent* ev) noexcept
+{
+    OFS_PROFILE(__FUNCTION__);
+    auto app = OpenFunscripter::ptr;
+    if (!app->ActiveFunscript()->Selection().empty()) {
+        factor = 2;
+        createUndoState = true;
+    }
+}
+
+// Keeps every Nth point. The first and last point are always kept so the selection's time
+// range/endpoints never shrink, only the density in between.
+static FunscriptArray DownsampleArray(const FunscriptArray& points, int32_t factor) noexcept
+{
+    FunscriptArray result;
+    int32_t n = (int32_t)points.size();
+    result.reserve(n / factor + 2);
+    for (int32_t i = 0; i < n; ++i) {
+        if (i % factor == 0 || i == n - 1) {
+            result.emplace_back_unsorted(points[i]);
+        }
+    }
+    return result;
+}
