+// scales every position in `baseline` by a straight percentage, anchored at 0 (not the
+// midpoint) - e.g. percent=50 turns a position of 40 into 20 and 100 into 50.
+// Takes an explicit baseline (rather than reading data.Selection directly) so callers can
+// keep recomputing from a fixed snapshot of the original values across multiple interactions
+// (drags, separate clicks) without compounding on top of whatever the last application left
+// behind - the current selection is replaced wholesale with the result each call.
+void Funscript::PercentScaleSelection(const FunscriptArray& baseline, float percent) noexcept
+{
+	OFS_PROFILE(__FUNCTION__);
+	if (baseline.empty()) return;
+	RemoveSelectedActions();
+	FunscriptArray newSelection;
+	for (auto act : baseline) {
+		float scaled = act.pos * (percent / 100.f);
+		act.pos = Util::Clamp<int16_t>((int16_t)std::round(scaled), 0, 100);
+		AddAction(act);
+		newSelection.emplace_back(act);
+	}
+	data.Selection = newSelection;
+}
